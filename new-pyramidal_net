weights = tf.reduce_mean(grads, axis=(1, 2))\n    cam = tf.reduce_sum(conv_out * weights[:, None, None, :], axis=-1)[0]\n    cam = tf.nn.relu(cam)                                       # keep only positive evidence\n    cam = cam / (tf.reduce_max(cam) + 1e-8)\n    cam = tf.image.resize(cam[..., None], (IMG_SIZE, IMG_SIZE))[..., 0].numpy()\n    return cam, class_index\n\ndef minmax(a):\n    return (a - a.min()) / (a.max() - a.min() + 1e-8)","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-11-24T09:28:22.249459Z","iopub.execute_input":"2026-11-24T09:28:22.249871Z","iopub.status.idle":"2026-11-24T09:28:22.257559Z","shell.execute_reply.started":"2026-11-24T09:28:22.249845Z","shell.execute_reply":"2026-11-24T09:28:22.256599Z"}},"outputs":[],"execution_count":59},{"cell_type":"markdown","source":"**Pick 10 test images and compute their Grad-CAM maps.**","metadata":{}},{"cell_type":"code","source":"N_EXPLAIN = 10\nidx = np.random.RandomState(SEED).choice(len(d[\"X_test\"]), min(N_EXPLAIN, len(d[\"X_test\"])), replace=False)\nsamples = d[\"X_test\"][idx].astype(\"float32\")\n\ncams, pred_cls = [], []\nfor img in samples:\n    cam, k = grad_cam(m, img)\n    cams.append(cam)\n    pred_cls.append(k)","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-11-24T09:28:25.483713Z","iopub.execute_input":"2026-11-24T09:28:25.484269Z","iopub.status.idle":"2026-11-24T09:28:27.253005Z","shell.execute_reply.started":"2026-11-24T09:28:25.484241Z","shell.execute_reply":"2026-11-24T09:28:27.252477Z"}},"outputs":[{"name":"stderr","text":"/usr/local/lib/python3.13/dist-packages/keras/src/models/functional.py:241: UserWarning: The structure of `inputs` doesn't match the expected structure.\nExpected: ['input']\nReceived: inputs=Tensor(shape=(1, 256, 256, 3))\n  warnings.warn(msg)\n","output_type":"stream"}],"execution_count":60},{"cell_type":"markdown","source":"**SHAP maps** for the same images. If SHAP cannot run with the library versions on Kaggle, a simpler method (gradient × input) is used instead and the plot titles say so.","metadata":{}},{"cell_type":"code","source":"def gradient_x_input(m, img, class_index):\n    x = tf.convert_to_tensor(img[None])\n    with tf.GradientTape() as tape:\n        tape.watch(x)\n        score = m(x, training=False)[:, class_index]\n    g = tape.gradient(score, x)[0].numpy()\n    return np.abs(g * img).sum(-1)\n\nSHAP_NSAMPLES = 10      # model evaluations per image and class: more = smoother but slower and needs more memory\n\ntry:\n    import shap\n    explainer = shap.GradientExplainer(m, d[\"background\"].astype(\"float32\"))\n    shap_maps = []\n    for img, k in zip(samples, pred_cls):                            # one image at a time keeps memory small\n        sv = explainer.shap_values(img[None], nsamples=SHAP_NSAMPLES)\n        v = sv[k][0] if isinstance(sv, list) else sv[0, ..., k]      # SHAP values of the predicted class\n        shap_maps.append(np.abs(v).sum(-1))\n    method = \"SHAP\"\nexcept Exception as e:\n    print(\"SHAP could not run here:\", repr(e)[:120], \"-> using gradient x input instead.\")\n    shap_maps = [gradient_x_input(m, s, k) for s, k in zip(samples, pred_cls)]\n    method = \"gradient x input\"","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-11-24T09:28:31.952245Z","iopub.execute_input":"2026-11-24T09:28:31.952654Z","iopub.status.idle":"2026-11-24T09:28:48.729387Z","shell.execute_reply.started":"2026-11-24T09:28:31.952628Z","shell.execute_reply":"2026-11-24T09:28:48.728695Z"}},"outputs":[{"name":"stderr","text":"/usr/local/lib/python3.13/dist-packages/keras/src/models/functional.py:241: UserWarning: The structure of `inputs` doesn't match the expected structure.\nExpected: input\nReceived: inputs=['Tensor(shape=(1, 256, 256, 3))']\n  warnings.warn(msg)\n/usr/local/lib/python3.13/dist-packages/keras/src/models/functional.py:241: UserWarning: The structure of `inputs` doesn't match the expected structure.\nExpected: input\nReceived: in