"source":"**Find the dataset folder.** A folder name like `tennis_court`, `Tennis Court` or `tenniscourt` counts as the same class.","metadata":{}},{"cell_type":"code","source":"IMG_EXT = (\".jpg\", \".jpeg\", \".png\", \".tif\", \".tiff\", \".bmp\")\n\ndef norm(name):\n    return re.sub(r\"[^a-z0-9]\", \"\", name.lower())\n\ndef make_folder_matcher(class_names):\n    # Maps a class folder name to its integer label, handling spaces/underscores.\n    wanted = {norm(c): i for i, c in enumerate(class_names)}\n\n    def folder_to_class(folder_name):\n        n = norm(folder_name)\n        for key in (n, n + \"s\", n.rstrip(\"s\")):\n            if key in wanted:\n                return wanted[key]\n        return None\n\n    return folder_to_class\n\ndef auto_find_root(cfg):\n    # Used by UCM's unsplit Images folder.\n    match = make_folder_matcher(cfg[\"classes\"])\n    roots = []\n    if cfg.get(\"root\") and os.path.isdir(cfg[\"root\"]):\n        roots.append(cfg[\"root\"])\n    roots.append(KAGGLE_INPUT)\n\n    seen = set()\n    for search_root in roots:\n        if search_root in seen:\n            continue\n        seen.add(search_root)\n        for dirpath, dirnames, _ in os.walk(search_root):\n            matched = {match(d) for d in dirnames} - {None}\n            if len(matched) == len(cfg[\"classes\"]):\n                return dirpath\n    return None\n\ndef find_split_root(cfg, split_names):\n    # Find a train/test directory whose immediate subfolders match our classes.\n    match = make_folder_matcher(cfg[\"classes\"])\n    roots = []\n    configured_root = cfg.get(\"root\")\n    if configured_root and os.path.isdir(configured_root):\n        roots.append(configured_root)\n    roots.append(KAGGLE_INPUT)\n\n    seen = set()\n    for search_root in roots:\n        if search_root in seen:\n            continue\n        seen.add(search_root)\n        for dirpath, dirnames, _ in os.walk(search_root):\n            if os.path.basename(dirpath).lower() not in split_names:\n                continue\n            matched = {match(d) for d in dirnames} - {None}\n            if len(matched) == len(cfg[\"classes\"]):\n                return dirpath\n\n    raise FileNotFoundError(\n        f\"Could not find a {sorted(split_names)} folder containing all selected \"\n        f\"classes for {cfg['title']}. Check the printed /kaggle/input structure.\"\n    )\n\ndef paths_from_split(split_root, cfg):\n    # Collect images only from this split. Class IDs follow cfg['classes'] order.\n    match = make_folder_matcher(cfg[\"classes\"])\n    per_class = {i: [] for i in range(len(cfg[\"classes\"]))}\n\n    for dirpath, _, filenames in os.walk(split_root):\n        relative_parts = os.path.relpath(dirpath, split_root).split(os.sep)\n        class_id = None\n        # Search path components from deepest to shallowest, excluding the split root.\n        for part in reversed(relative_parts):\n            class_id = match(part)\n            if class_id is not None:\n                break\n\n        if class_id is not None:\n            per_class[class_id].extend(\n                os.path.join(dirpath, filename)\n                for filename in filenames\n                if filename.lower().endswith(IMG_EXT)\n            )\n\n    paths, labels = [], []\n    for class_id in range(len(cfg[\"classes\"])):\n        class_paths = sorted(set(per_class[class_id]))\n        paths.extend(class_paths)\n        labels.extend([class_id] * len(class_paths))\n\n    return paths, np.asarray(labels, dtype=np.int32)\n\ndef find_image_paths(cfg):\n    # UCM is supplied as one Images folder; use its first n_per_class images/class.\n    match = make_folder_matcher(cfg[\"classes\"])\n    root = cfg[\"root\"] if cfg.get(\"root\") and os.path.isdir(cfg[\"root\"]) else auto_find_root(cfg)\n    if root is None:\n        raise FileNotFoundError(\n            f\"Could not find {cfg['title']} under {KAGGLE_INPUT}. \"\n            \"Attach the dataset with Add Input or set its root path.\"\n        )\n    print(f\"{cfg['title']} found at: {root}\")\n\n    per_class = {i: [] for i in range(len(cfg[\"classes\"]))}\n    for dirpath, _, filenames in os.walk(root):\n        class_id = match(os.path.basename(dirpath))\n        if class_id is not None:\n            per_class[class_id].extend(\n                os.path.join(dirpath, filename)\n                for filename in filenames\n                if filename.lower().endswith(IMG_EXT)\n            )\n\n    paths, labels = [], []\n    for class_id in range(len(cfg[\"classes\"])):\n        chosen = sorted(set(per_class[class_id]))[:cfg[\"n_per_class\"]]\n        paths.extend(chosen)\n        labels.extend([class_id] * len(chosen))\n\n    return paths, np.asarray(labels, dtype=np.int32)","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-11-24T09:17:39.454808Z","iopub.execute_input":"2026-11-24T09:17:39.455565Z","iopub.status.idle":"2026-11-24T09:17:39.471543Z","shell.execute_reply.started":"2026-11-24T09:17:39.455536Z","shell.execute_reply":"2026-11-24T09:17:39.470967Z"}},"outputs":[],"execution_count":33},{"cell_type":"markdown","source":"**List the image files** of the 10 classes (first `n_per_class` images of each class).","metadata":{}},{"cell_type":"code","source":"def find_image_paths(cfg):\n    folder_to_class = make_folder_matcher(cfg[\"classes\"])\n    root = cfg[\"root\"] if cfg[\"root\"] and os.path.isdir(cfg[\"root\"]) else auto_find_root(cfg)\n    if root is None:\n        raise FileNotFoundError(f\"Could not find {cfg['title']} in {KAGGLE_INPUT}. Did you attach it with 'Add Input'?\")\n    print(f\"{cfg['title']} found at: {root}\")\n\n    per_class = {i: [] for i in range(len(cfg[\"classes\"]))}\n    for dirpath, _, filenames in os.walk(root):\n        cls = folder_to_class(os.path.basename(dirpath))\n        if cls is not None:\n            per_class[cls] += [os.path.join(dirpath, f) for f in filenames if f.lower().endswith(IMG_EXT)]\n\n    paths, labels = [], []\n    for i in range(len(cfg[\"classes\"])):\n        chosen = sorted(per_class[i])[:cfg[\"n_per_class\"]]    # sorted -> same images every run\n        paths += chosen\n        labels += [i] * len(chosen)\n    return paths, np.array(labels)","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-11-24T09:17:44.196793Z","iopub.execute_input":"2026-11-24T09:17:44.197405Z","iopub.status.idle":"2026-11-24T09:17:44.203949Z","shell.execute_reply.started":"2026-11-24T09:17:44.197378Z","shell.execute_reply":"2026-11-24T09:17:44.203258Z"}},"outputs":[],"execution_count":34},{"cell_type":"markdown","source":"**Load the images.** The only preprocessing is resizing to 256×256 (pixel values stay in 0 to 255).","metadata":{}},{"cell_type":"code","source":"def load_images(paths):\n    images = []\n    for p in tqdm(paths, desc=\"loading\"):\n        img = Image.open(p).convert(\"RGB\")\n        if img.size != (IMG_SIZE, IMG_SIZE):\n            img = img.resize((IMG_SIZE, IMG_SIZE))\n        images.append(np.asarray(img, dtype=np.uint8))\n    return np.stack(images)","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-11-24T09:17:46.974527Z","iopub.execute_input":"2026-11-24T09:17:46.97501Z","iopub.status.idle":"2026-11-24T09:17:46.979578Z","shell.execute_reply.started":"2026-11-24T09:17:46.974985Z","shell.execute_reply":"2026-11-24T09:17:46.978774Z"}},"outputs":[],"execution_count":35},{"cell_type":"markdown","source":"**Split** 70 / 15 / 15: first 15 % of all images become the test set, then 15 % of the rest become the validation set. Stratified, so every class keeps the same share.","metadata":{}},{"cell_type":"code","source":"def split_data(labels):\n    idx = np.arange(len(labels))\n    trainval_idx, test_idx = train_test_split(idx, test_size=0.15, stratify=labels, random_state=SEED)\n    train_idx, val_idx = train_test_split(trainval_idx, test_size=0.15,\n                                          stratify=labels[trainval_idx], random_state=SEED)\n    return train_idx, val_idx, test_idx","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-11-24T09:17:49.346199Z","iopub.execute_input":"2026-11-24T09:17:49.346805Z","iopub.status.idle":"2026-11-24T09:17:49.35288Z","shell.execute_reply.started":"2026-11-24T09:17:49.346776Z","shell.execute_reply":"2026-11-24T09:17:49.352136Z"}},"outputs":[],"execution_count":36},{"cell_type":"markdown","source":"**Online augmentation (optional experiment only).** This mode applies horizontal/vertical flips and random rotation during training. Brightness is disabled in the paper-matching baseline. The default below uses `expand` mode to follow Algorithm 1.","metadata":{}},{"cell_type":"code","source":"flip_layer   = layers.RandomFlip(\"horizontal_and_vertical\")\nrotate_layer = layers.RandomRotation(factor=0.5, fill_mode=\"nearest\")   # 0.5 of a full turn = +-180 degrees\n\ndef augment(x):\n    \"\"\"x: a batch of images, shape (B, 256, 256, 3), float32, values 0..255\"\"\"\n    x = flip_layer(x, training=True)\n    x = rotate_layer(x, training=True)\n    if USE_BRIGHTNESS:\n        factor = tf.random.uniform([tf.shape(x)[0], 1, 1, 1], 0.1, 2.0)   # one brightness factor per image\n        x = tf.clip_by_value(x * factor, 0.0, 255.0)\n    return x","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-11-24T09:17:51.46939Z","iopub.execute_input":"2026-11-24T09:17:51.469802Z","iopub.status.idle":"2026-11-24T09:17:51.48455Z","shell.execute_reply.started":"2026-11-24T09:17:51.469776Z","shell.execute_reply":"2026-11-24T09:17:51.483736Z"}},"outputs":[],"execution_count":37},{"cell_type":"markdown","source":"**Augmentation, `expand` mode (Algorithm 1):** one training image becomes five.","metadata":{}},{"cell_type":"code","source":"def five_versions(x, y):\n    x = tf.cast(x, tf.float32)\n    rotated = rotate_layer(x[None], training=True)[0]       # (a batch of one image, then unwrap it)\n    versions = tf.stack([\n        x,                              # the original image\n        rotated,                        # Data1: random rotation\n        tf.image.flip_left_right(x),    # Data2: horizontal flip\n        tf.image.flip_up_down(x),       # Data3: vertical flip\n        x,                              # Data4: zoom range 0.0 = no zoom = identical copy\n    ])\n    return tf.data.Dataset.from_tensor_slices((versions, tf.fill([5], y)))","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-11-24T09:17:54.385754Z","iopub.execute_input":"2026-11-24T09:17:54.386204Z","iopub.status.idle":"2026-11-24T09:17:54.391359Z","shell.execute_reply.started":"2026-11-24T09:17:54.386177Z","shell.execute_reply":"2026-11-24T09:17:54.390601Z"}},"outputs":[],"execution_count":38},{"cell_type":"markdown","source":"**Input pipeline.** Training images are shuffled and augmented; validation and test images are never augmented.","metadata":{}},{"cell_type":"code","source":"def make_dataset(X_np, y_np, training, expand=False):\n    ds = tf.data.Dataset.from_tensor_slices((X_np, y_np))\n    if not training:\n        ds = ds.batch(BATCH_SIZE).map(lambda x, y: (tf.cast(x, tf.float32), y))\n        return ds.prefetch(tf.data.AUTOTUNE)\n\n    ds = ds.shuffle(len(X_np), seed=SEED, reshuffle_each_iteration=True)\n    if expand:\n        ds = ds.flat_map(five_versions).shuffle(1000, seed=SEED).batch(BATCH_SIZE)\n    else:\n        ds = ds.batch(BATCH_SIZE).map(lambda x, y: (augment(tf.cast(x, tf.float32)), y),\n                                      num_parallel_calls=tf.data.AUTOTUNE)\n    return ds.prefetch(tf.data.AUTOTUNE)","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-11-24T09:17:56.253869Z","iopub.execute_input":"2026-11-24T09:17:56.254445Z","iopub.status.idle":"2026-11-24T09:17:56.260197Z","shell.execute_reply.started":"2026-11-24T09:17:56.254409Z","shell.execute_reply":"2026-11-24T09:17:56.259365Z"}},"outputs":[],"execution_count":39},{"cell_type":"markdown","source":"## 3. The Pyramidal Net\nAll convolutions: 3×3, stride 1, `valid` padding, ReLU.\n\n```\nInput 256x256x3\nConv 256 -> MaxPool 2x2 -> BatchNorm\nConv 128 -> MaxPool 2x2 -> BatchNorm\nConv 128 -> Conv 128 -> Conv 64 -> MaxPool 2x2\nFlatten (50,176 values)\nDense 512 -> 256 -> 64 -> 16 -> 10 (softmax)\n```\nCheck: `valid` padding removes 2 pixels per convolution and each pooling halves the size: 256 → 254 → 127 → 125 → 62 → 60 → 58 → 56 → 28, and 28 × 28 × 64 = **50,176**.","metadata":{}},{"cell_type":"code","source":"def build_pyramidal_net(num_classes):\n    conv = dict(kernel_size=3, strides=1, padding=\"valid\", activation=\"relu\")\n\n    inputs = keras.Input(shape=(IMG_SIZE, IMG_SIZE, 3), name=\"input\")\n\n    # block 1\n    x = layers.Conv2D(256, name=\"conv1\", **conv)(inputs)\n    x = layers.MaxPooling2D(2, padding=\"valid\", name=\"pool1\")(x)\n    x = layers.BatchNormalization(name=\"bn1\")(x)\n\n    # block 2\n    x = layers.Conv2D(128, name=\"conv2\", **conv)(x)\n    x = layers.MaxPooling2D(2, padding=\"valid\", name=\"pool2\")(x)\n    x = layers.BatchNormalization(name=\"bn2\")(x)\n\n    # block 3\n    x = layers.Conv2D(128, name=\"conv3\", **conv)(x)\n    x = layers.Conv2D(128, name=\"conv4\", **conv)(x)\n    x = layers.Conv2D(64,  name=\"conv5\", **conv)(x)\n    x = layers.MaxPooling2D(2, padding=\"valid\", name=\"pool3\")(x)\n\n    # fully connected part\n    x = layers.Flatten(name=\"flatten\")(x)\n    assert x.shape[-1] == 50176\n    x = layers.Dense(512, activation=\"relu\", name=\"fc1\")(x)\n    x = layers.Dense(256, activation=\"relu\", name=\"fc2\")(x)\n    x = layers.Dense(64,  activation=\"relu\", name=\"fc3\")(x)\n    x = layers.Dense(16,  activation=\"relu\", name=\"fc4\")(x)\n    outputs = layers.Dense(num_classes, activation=\"softmax\", name=\"output\")(x)\n\n    return keras.Model(inputs, outputs, name=\"pyramidal_net\")\n\nbuild_pyramidal_net(10).summary()","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-11-24T09:17:58.412793Z","iopub.execute_input":"2026-11-24T09:1